#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/build/settings-target}"
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-4}"
mkdir -p "$ROOT/build/settings" "$ROOT/build/settings-tmp"
export TMPDIR="$ROOT/build/settings-tmp"
cargo test --locked --manifest-path "$ROOT/settings/Cargo.toml"
cargo build --locked --manifest-path "$ROOT/settings/Cargo.toml"
APP="$CARGO_TARGET_DIR/debug/voxtype-settings"
unset VOXTYPE_SETTINGS_THEME_FILE
unset VOXTYPE_SETTINGS_TEXT_SCALE
for page in overview engine audio output osd advanced config edited invalid search help; do
    "$APP" --scene "$page" --scale 1.25 --at 0.5 \
        --snap "$ROOT/build/settings/$page.png" --tree "$ROOT/build/settings/$page.json"
done
"$APP" --scene engine --size 840x620 --scale 1.25 --at 0.5 \
    --snap "$ROOT/build/settings/minimum-engine.png" --tree "$ROOT/build/settings/minimum-engine.json"
VOXTYPE_SETTINGS_TEXT_SCALE=0.8182 \
    "$APP" --scene engine --scale 1.25 --at 0.5 \
    --snap "$ROOT/build/settings/desktop-scaled-engine.png" --tree "$ROOT/build/settings/desktop-scaled-engine.json"
VOXTYPE_SETTINGS_THEME_FILE="$ROOT/settings/fixtures/forest.toml" \
    "$APP" --scene audio --scale 1.25 --at 0.5 \
    --snap "$ROOT/build/settings/theme-audio.png" --tree "$ROOT/build/settings/theme-audio.json"
